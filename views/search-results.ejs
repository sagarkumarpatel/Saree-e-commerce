<!DOCTYPE html>
<html>
<head>
  <title>Search Results - Saree Store</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<%- include("partials/navbar") %>

<div class="container mt-4">
  <div class="mb-4">
    <h3>
      <i class="fas fa-search"></i> Search Results
      <% if (searchQuery) { %>
        <small class="text-muted">for "<%= searchQuery %>"</small>
      <% } %>
    </h3>
    <p class="text-muted">
      <% if (sarees.length > 0) { %>
        Found <%= sarees.length %> product<%= sarees.length > 1 ? 's' : '' %>
      <% } %>
    </p>
  </div>

  <% if (message) { %>
    <div class="alert alert-info">
      <i class="fas fa-info-circle"></i> <%= message %>
    </div>
    <div class="text-center mt-4">
      <a href="/" class="btn btn-dark">
        <i class="fas fa-home"></i> Back to Home
      </a>
    </div>
  <% } else { %>
    <div class="row">
      <% sarees.forEach(saree => { %>
        <div class="col-md-4 mb-4">
          <div class="card h-100">
            <img src="<%= saree.image.url %>" class="card-img-top" alt="<%= saree.title %>">
            <div class="card-body">
              <h5 class="card-title"><%= saree.title %></h5>
              <% if (saree.description) { %>
                <p class="card-text text-muted small"><%= saree.description.substring(0, 100) %><%= saree.description.length > 100 ? '...' : '' %></p>
              <% } %>
              <% if (saree.category) { %>
                <span class="badge bg-info mb-2"><%= saree.category %></span>
              <% } %>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <% if (saree.discountPercent > 0) { %>
                    <% const calculatedFinalPrice = saree.finalPrice || (saree.price - (saree.price * saree.discountPercent / 100)); %>
                    <span class="text-decoration-line-through text-muted me-2">₹<%= saree.price %></span>
                    <span class="fw-bold text-success">₹<%= Math.round(calculatedFinalPrice) %></span>
                  <% } else { %>
                    <span class="fw-bold">₹<%= saree.price %></span>
                  <% } %>
                </div>
                <div>
                  <% if (saree.discountPercent > 0) { %>
                    <span class="badge bg-danger me-1"><%= saree.discountPercent %>% OFF</span>
                  <% } %>
                  <% if (saree.stockStatus === 'In Stock') { %>
                    <span class="badge bg-success">In Stock</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Out of Stock</span>
                  <% } %>
                </div>
              </div>
              <form action="/cart/add/<%= saree._id %>" method="POST">
                <button class="btn btn-dark w-100" <%= saree.stockStatus !== 'In Stock' ? 'disabled' : '' %>>
                  <i class="fas fa-cart-plus"></i> Add to Cart
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="text-center mt-4 mb-4">
      <a href="/" class="btn btn-outline-dark">
        <i class="fas fa-home"></i> Back to Home
      </a>
    </div>
  <% } %>
</div>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
