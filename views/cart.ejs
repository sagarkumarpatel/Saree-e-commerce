<!DOCTYPE html>
<html>
<head>
  <title>Shopping Cart - Saree Store</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<%- include("partials/navbar") %>

<div class="container mt-4">
  <h2 class="mb-4">Shopping Cart</h2>

  <% if (!cart || !cart.items || cart.items.length === 0) { %>
    <div class="alert alert-info">
      <i class="fas fa-shopping-cart"></i> Your cart is empty.
      <a href="/sarees" class="alert-link">Continue Shopping</a>
    </div>
  <% } else { %>
    <div class="row">
      <div class="col-md-8">
        <div class="card">
          <div class="card-body">
            <% let total = 0; %>
            <% cart.items.forEach(item => { %>
              <% if (item.saree) { %>
                <% const itemPrice = item.saree.finalPrice || item.saree.price; %>
                <% const itemTotal = itemPrice * item.quantity; %>
                <% total += itemTotal; %>
                <div class="row mb-3 pb-3 border-bottom">
                  <div class="col-md-2">
                    <img src="<%= item.saree.image.url %>" class="img-fluid" alt="<%= item.saree.title %>" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;">
                  </div>
                  <div class="col-md-4">
                    <h5><%= item.saree.title %></h5>
                    <% if (item.saree.description) { %>
                      <p class="text-muted small mb-1"><%= item.saree.description.substring(0, 80) %><%= item.saree.description.length > 80 ? '...' : '' %></p>
                    <% } %>
                    <p class="text-muted mb-0"><span class="badge bg-info"><%= item.saree.category || 'Saree' %></span></p>
                    <% if (item.saree.discountPercent > 0) { %>
                      <span class="badge bg-danger mt-1"><%= item.saree.discountPercent %>% OFF</span>
                    <% } %>
                  </div>
                  <div class="col-md-2">
                    <% if (item.saree.discountPercent > 0) { %>
                      <% const calculatedFinalPrice = item.saree.finalPrice || (item.saree.price - (item.saree.price * item.saree.discountPercent / 100)); %>
                      <p class="mb-0 text-decoration-line-through text-muted small">₹<%= item.saree.price %></p>
                      <p class="mb-0 fw-bold text-success">₹<%= Math.round(calculatedFinalPrice) %></p>
                    <% } else { %>
                      <p class="mb-0">₹<%= item.saree.price %></p>
                    <% } %>
                  </div>
                  <div class="col-md-2">
                    <div class="d-flex align-items-center">
                      <form action="/cart/update/<%= item.saree._id %>" method="POST" style="display: inline;">
                        <input type="hidden" name="action" value="decrease">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">-</button>
                      </form>
                      <span class="mx-2"><strong><%= item.quantity %></strong></span>
                      <form action="/cart/update/<%= item.saree._id %>" method="POST" style="display: inline;">
                        <input type="hidden" name="action" value="increase">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">+</button>
                      </form>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <p class="mb-0 fw-bold">₹<%= itemTotal %></p>
                    <form action="/cart/remove/<%= item.saree._id %>" method="POST" class="mt-2">
                      <button type="submit" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              <% } %>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card">
          <div class="card-body">
            <h4 class="card-title">Order Summary</h4>
            <hr>
            <div class="d-flex justify-content-between mb-2">
              <span>Subtotal:</span>
              <span>₹<%= total %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Shipping:</span>
              <span>Free</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-3">
              <strong>Total:</strong>
              <strong>₹<%= total %></strong>
            </div>
            <a href="/checkout" class="btn btn-dark w-100 mb-2">Proceed to Checkout</a>
            <a href="/sarees" class="btn btn-outline-secondary w-100">Continue Shopping</a>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Cancelled Carts Section -->
  <% if (cancelledCarts && cancelledCarts.length > 0) { %>
    <div class="row mt-5">
      <div class="col-12">
        <h4 class="mb-3">Cancelled Orders</h4>
        <% cancelledCarts.forEach(cancelledCart => { %>
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="fas fa-times-circle fa-2x me-3"></i>
            <div class="flex-grow-1">
              <h5 class="alert-heading mb-2">Your order was cancelled by admin</h5>
              <p class="mb-1">Cancelled on: <%= new Date(cancelledCart.cancelledAt).toLocaleString() %></p>
              <hr>
              <div class="small">
                <strong>Items:</strong>
                <ul class="mb-0 mt-2">
                  <% cancelledCart.items.forEach(item => { %>
                    <% if (item.saree) { %>
                      <li><%= item.saree.title %> - Qty: <%= item.quantity %> - ₹<%= item.saree.price * item.quantity %></li>
                    <% } %>
                  <% }) %>
                </ul>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
