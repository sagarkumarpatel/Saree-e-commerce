<%- include("../partials/header") %>

<div class="container mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-edit"></i> Edit Product</h2>
    <a href="/admin/inventory" class="btn btn-secondary">
      <i class="fas fa-arrow-left"></i> Back to Inventory
    </a>
  </div>

  <div class="card">
    <div class="card-body">
      <form action="/admin/edit-saree/<%= saree._id %>" method="POST" enctype="multipart/form-data">
        
        <!-- Product Title -->
        <div class="mb-3">
          <label for="title" class="form-label">Product Title *</label>
          <input 
            type="text" 
            class="form-control" 
            id="title" 
            name="title" 
            value="<%= saree.title %>"
            required
          >
        </div>

        <!-- Product Description -->
        <div class="mb-3">
          <label for="description" class="form-label">Product Description</label>
          <textarea 
            class="form-control" 
            id="description" 
            name="description" 
            rows="4"
            placeholder="Enter detailed product description"
          ><%= saree.description || '' %></textarea>
        </div>

        <!-- Category Dropdown -->
        <div class="mb-3">
          <label for="category" class="form-label">Category *</label>
          <select class="form-select" id="category" name="category" required>
            <option value="">Select Category</option>
            <option value="Silk" <%= saree.category === 'Silk' ? 'selected' : '' %>>Silk</option>
            <option value="Cotton" <%= saree.category === 'Cotton' ? 'selected' : '' %>>Cotton</option>
            <option value="Banarasi" <%= saree.category === 'Banarasi' ? 'selected' : '' %>>Banarasi</option>
            <option value="Kanjeevaram" <%= saree.category === 'Kanjeevaram' ? 'selected' : '' %>>Kanjeevaram</option>
            <option value="Party Wear" <%= saree.category === 'Party Wear' ? 'selected' : '' %>>Party Wear</option>
            <option value="Daily Wear" <%= saree.category === 'Daily Wear' ? 'selected' : '' %>>Daily Wear</option>
            <option value="Festive" <%= saree.category === 'Festive' ? 'selected' : '' %>>Festive</option>
            <option value="Bridal" <%= saree.category === 'Bridal' ? 'selected' : '' %>>Bridal</option>
            <option value="Designer" <%= saree.category === 'Designer' ? 'selected' : '' %>>Designer</option>
          </select>
        </div>

        <div class="row">
          <!-- Price -->
          <div class="col-md-6 mb-3">
            <label for="price" class="form-label">Original Price (MRP) *</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input 
                type="number" 
                class="form-control" 
                id="price" 
                name="price" 
                value="<%= saree.price %>"
                min="0" 
                step="1" 
                required
              >
            </div>
          </div>

          <!-- Discount Percentage -->
          <div class="col-md-6 mb-3">
            <label for="discountPercent" class="form-label">Discount %</label>
            <div class="input-group">
              <input 
                type="number" 
                class="form-control" 
                id="discountPercent" 
                name="discountPercent" 
                value="<%= saree.discountPercent || 0 %>"
                min="0" 
                max="100"
                step="1"
              >
              <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">Leave 0 for no discount. Final price will be calculated automatically.</small>
          </div>
        </div>

        <!-- Stock Quantity -->
        <div class="mb-3">
          <label for="stock" class="form-label">Stock Quantity *</label>
          <input 
            type="number" 
            class="form-control" 
            id="stock" 
            name="stock" 
            value="<%= saree.stock || 0 %>"
            min="0" 
            required
          >
          <small class="text-muted">Stock status will be automatically updated based on quantity</small>
        </div>

        <!-- Product Status -->
        <div class="mb-3">
          <label for="productStatus" class="form-label">Product Status *</label>
          <select class="form-select" id="productStatus" name="productStatus" required>
            <option value="Active" <%= saree.productStatus === 'Active' ? 'selected' : '' %>>Active (Visible to customers)</option>
            <option value="Inactive" <%= saree.productStatus === 'Inactive' ? 'selected' : '' %>>Inactive (Hidden from customers)</option>
          </select>
        </div>

        <!-- Current Image Display -->
        <div class="mb-3">
          <label class="form-label">Current Image</label>
          <div>
            <img src="<%= saree.image.url %>" alt="<%= saree.title %>" style="max-width: 300px; max-height: 300px; object-fit: cover;" class="img-thumbnail">
          </div>
        </div>

        <!-- Upload New Image -->
        <div class="mb-3">
          <label for="image" class="form-label">Upload New Image (optional)</label>
          <input 
            type="file" 
            class="form-control" 
            id="image" 
            name="image" 
            accept="image/*"
          >
          <small class="text-muted">Leave empty to keep current image. Upload a new image to replace it.</small>
        </div>

        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="fas fa-save"></i> Update Product
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
