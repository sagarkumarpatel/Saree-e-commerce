<%- include("../partials/header") %>

<div class="container mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users"></i> User Order History</h2>
    <a href="/admin/dashboard" class="btn btn-secondary">
      <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
  </div>

  <% if (!users || users.length === 0) { %>
    <div class="alert alert-info">
      <i class="fas fa-info-circle"></i> No users found.
    </div>
  <% } else { %>
    <div class="card">
      <div class="card-header bg-dark text-white">
        <h5 class="mb-0">All Users</h5>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-dark">
              <tr>
                <th>User ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Total Orders</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(user => { %>
                <tr>
                  <td><strong><%= user._id.toString().slice(-6).toUpperCase() %></strong></td>
                  <td><%= user.name %></td>
                  <td><%= user.email %></td>
                  <td>
                    <span class="badge <%= user.orderCount > 0 ? 'bg-primary' : 'bg-secondary' %> fs-6">
                      <%= user.orderCount %>
                    </span>
                  </td>
                  <td>
                    <a href="/admin/users/<%= user._id %>/orders" class="btn btn-sm btn-primary">
                      <i class="fas fa-eye"></i> View Orders
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include("../partials/footer") %>
