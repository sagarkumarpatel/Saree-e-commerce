<%- include("../partials/header") %>

<div class="container mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user"></i> User Order History</h2>
    <a href="/admin/users" class="btn btn-secondary">
      <i class="fas fa-arrow-left"></i> Back to Users
    </a>
  </div>

  <!-- User Details Section -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0"><i class="fas fa-user-circle"></i> User Details</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <p><strong>User ID:</strong><br><%= user._id.toString().slice(-6).toUpperCase() %></p>
        </div>
        <div class="col-md-3">
          <p><strong>Name:</strong><br><%= user.name %></p>
        </div>
        <div class="col-md-3">
          <p><strong>Email:</strong><br><%= user.email %></p>
        </div>
        <div class="col-md-3">
          <p><strong>Total Orders:</strong><br>
            <span class="badge bg-primary fs-6"><%= orders.length %></span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- User's Orders Section -->
  <div class="card">
    <div class="card-header bg-dark text-white">
      <h5 class="mb-0"><i class="fas fa-list"></i> All Orders</h5>
    </div>
    <div class="card-body">
      <% if (!orders || orders.length === 0) { %>
        <div class="alert alert-info">
          <i class="fas fa-info-circle"></i> This user has not placed any orders yet.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-dark">
              <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(order => { %>
                <tr>
                  <td><strong>#<%= order._id.toString().slice(-6).toUpperCase() %></strong></td>
                  <td><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></td>
                  <td><strong>₹<%= order.totalAmount %></strong></td>
                  <td>
                    <% if (order.status === 'New') { %>
                      <span class="badge bg-info"><%= order.status %></span>
                    <% } else if (order.status === 'Confirmed') { %>
                      <span class="badge bg-warning"><%= order.status %></span>
                    <% } else if (order.status === 'Shipped') { %>
                      <span class="badge" style="background-color: #6f42c1;"><%= order.status %></span>
                    <% } else if (order.status === 'Delivered') { %>
                      <span class="badge bg-success"><%= order.status %></span>
                    <% } else if (order.status === 'Cancelled') { %>
                      <span class="badge bg-danger"><%= order.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-primary">
                      <i class="fas fa-eye"></i> View
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
