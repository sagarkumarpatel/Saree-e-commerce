<%- include("../partials/header") %>

<div class="container mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-list"></i> All Orders</h2>
    <a href="/admin/dashboard" class="btn btn-secondary">
      <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
  </div>

  <% if (!orders || orders.length === 0) { %>
    <div class="alert alert-info">
      <i class="fas fa-info-circle"></i> No orders found.
    </div>
  <% } else { %>
    <div class="card">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-dark">
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(order => { %>
                <tr>
                  <td><strong>#<%= order._id.toString().slice(-6).toUpperCase() %></strong></td>
                  <td>
                    <%= order.user ? order.user.name : 'Unknown' %><br>
                    <small class="text-muted"><%= order.user ? order.user.email : '-' %></small>
                  </td>
                  <td><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></td>
                  <td><strong>₹<%= order.totalAmount %></strong></td>
                  <td>
                    <% if (order.status === 'New') { %>
                      <span class="badge bg-info"><%= order.status %></span>
                    <% } else if (order.status === 'Confirmed') { %>
                      <span class="badge bg-warning"><%= order.status %></span>
                    <% } else if (order.status === 'Shipped') { %>
                      <span class="badge" style="background-color: #6f42c1;"><%= order.status %></span>
                    <% } else if (order.status === 'Delivered') { %>
                      <span class="badge bg-success"><%= order.status %></span>
                    <% } else if (order.status === 'Cancelled') { %>
                      <span class="badge bg-danger"><%= order.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-primary">
                      <i class="fas fa-eye"></i> View
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include("../partials/footer") %>
