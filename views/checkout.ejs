<!DOCTYPE html>
<html>
<head>
  <title>Checkout - Saree Store</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<%- include("partials/navbar") %>

<div class="container mt-4 mb-5">
  <h2 class="mb-4"><i class="fas fa-shopping-bag"></i> Checkout</h2>

  <div class="row">
    <!-- Shipping Details Form -->
    <div class="col-md-7">
      <div class="card">
        <div class="card-header bg-dark text-white">
          <h4 class="mb-0"><i class="fas fa-shipping-fast"></i> Shipping Details</h4>
        </div>
        <div class="card-body">
          <form action="/checkout" method="POST">
            <div class="mb-3">
              <label for="fullName" class="form-label">Full Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="fullName" name="fullName" value="<%= user.name %>" required>
            </div>

            <div class="mb-3">
              <label for="mobileNumber" class="form-label">Mobile Number <span class="text-danger">*</span></label>
              <input type="tel" class="form-control" id="mobileNumber" name="mobileNumber" placeholder="9XXXXXXXXX" pattern="[0-9]{10}" required>
              <div class="form-text">10-digit mobile number</div>
            </div>

            <div class="mb-3">
              <label for="addressLine1" class="form-label">Address Line 1 <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addressLine1" name="addressLine1" placeholder="House No, Street" required>
            </div>

            <div class="mb-3">
              <label for="addressLine2" class="form-label">Address Line 2 (Optional)</label>
              <input type="text" class="form-control" id="addressLine2" name="addressLine2" placeholder="Area, Landmark">
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="city" class="form-label">City <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="city" name="city" placeholder="Coimbatore" required>
              </div>

              <div class="col-md-6 mb-3">
                <label for="state" class="form-label">State <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="state" name="state" placeholder="Tamil Nadu" required>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="pincode" class="form-label">Pincode <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="pincode" name="pincode" placeholder="641107" pattern="[0-9]{6}" required>
              </div>

              <div class="col-md-6 mb-3">
                <label for="country" class="form-label">Country</label>
                <input type="text" class="form-control" id="country" name="country" value="India" readonly>
              </div>
            </div>

            <div class="d-grid gap-2 mt-4">
              <button type="submit" class="btn btn-dark btn-lg">
                <i class="fas fa-check-circle"></i> Place Order
              </button>
              <a href="/cart" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Back to Cart
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Order Summary -->
    <div class="col-md-5">
      <div class="card sticky-top" style="top: 20px;">
        <div class="card-header bg-dark text-white">
          <h4 class="mb-0"><i class="fas fa-receipt"></i> Order Summary</h4>
        </div>
        <div class="card-body">
          <% let total = 0; %>
          <% cart.items.forEach(item => { %>
            <% if (item.saree) { %>
              <% const itemPrice = item.saree.finalPrice || item.saree.price; %>
              <% const itemTotal = itemPrice * item.quantity; %>
              <% total += itemTotal; %>
              <div class="d-flex mb-3 pb-3 border-bottom">
                <img src="<%= item.saree.image.url %>" style="width: 60px; height: 60px; object-fit: cover;" class="me-3">
                <div class="flex-grow-1">
                  <h6 class="mb-1"><%= item.saree.title %></h6>
                  <% if (item.saree.discountPercent > 0) { %>
                    <% const calculatedFinalPrice = item.saree.finalPrice || (item.saree.price - (item.saree.price * item.saree.discountPercent / 100)); %>
                    <small class="text-muted">Qty: <%= item.quantity %> × <span class="text-decoration-line-through">₹<%= item.saree.price %></span> <span class="text-success">₹<%= Math.round(calculatedFinalPrice) %></span></small>
                    <span class="badge bg-danger ms-1"><%= item.saree.discountPercent %>% OFF</span>
                  <% } else { %>
                    <small class="text-muted">Qty: <%= item.quantity %> × ₹<%= item.saree.price %></small>
                  <% } %>
                  <div class="fw-bold">₹<%= itemTotal %></div>
                </div>
              </div>
            <% } %>
          <% }) %>

          <div class="mt-3">
            <div class="d-flex justify-content-between mb-2">
              <span>Subtotal:</span>
              <span>₹<%= total %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Shipping:</span>
              <span class="text-success">Free</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Tax:</span>
              <span>₹0</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between">
              <strong>Total:</strong>
              <strong class="text-dark fs-4">₹<%= total %></strong>
            </div>
          </div>

          <div class="alert alert-info mt-3 mb-0">
            <small><i class="fas fa-info-circle"></i> Cash on Delivery available</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
