<!DOCTYPE html>
<html>
<head>
  <title>My Orders - Saree Store</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<%- include("partials/navbar") %>

<div class="container mt-4 mb-5">
  <h2 class="mb-4"><i class="fas fa-receipt"></i> My Orders</h2>

  <% if (!orders || orders.length === 0) { %>
    <div class="alert alert-info">
      <i class="fas fa-info-circle"></i> You haven't placed any orders yet.
      <a href="/sarees" class="alert-link">Start Shopping</a>
    </div>
  <% } else { %>
    <div class="row">
      <% orders.forEach(order => { %>
        <div class="col-12 mb-3">
          <div class="card">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
              <div>
                <h5 class="mb-1">Order #<%= order._id.toString().slice(-6).toUpperCase() %></h5>
                <small class="text-muted">
                  <i class="fas fa-calendar"></i> Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </small>
              </div>
              <div>
                <% if (order.status === 'New') { %>
                  <span class="badge bg-info fs-6"><i class="fas fa-clock"></i> <%= order.status %></span>
                <% } else if (order.status === 'Confirmed') { %>
                  <span class="badge bg-warning fs-6"><i class="fas fa-check"></i> <%= order.status %></span>
                <% } else if (order.status === 'Shipped') { %>
                  <span class="badge fs-6" style="background-color: #6f42c1;"><i class="fas fa-shipping-fast"></i> <%= order.status %></span>
                <% } else if (order.status === 'Delivered') { %>
                  <span class="badge bg-success fs-6"><i class="fas fa-check-circle"></i> <%= order.status %></span>
                <% } else if (order.status === 'Cancelled') { %>
                  <span class="badge bg-danger fs-6"><i class="fas fa-times-circle"></i> <%= order.status %></span>
                <% } %>
              </div>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-8">
                  <h6 class="mb-2">Items:</h6>
                  <% order.products.forEach((item, index) => { %>
                    <% if (index < 2) { %>
                      <div class="d-flex mb-2 align-items-center">
                        <% if (item.saree && item.saree.image) { %>
                          <img src="<%= item.saree.image.url %>" style="width: 50px; height: 50px; object-fit: cover;" class="me-3">
                        <% } %>
                        <div>
                          <strong><%= item.saree ? (item.saree.title || item.saree.name) : 'Product' %></strong>
                          <small class="text-muted"> × <%= item.quantity %></small>
                        </div>
                      </div>
                    <% } %>
                  <% }) %>
                  <% if (order.products.length > 2) { %>
                    <small class="text-muted">+ <%= order.products.length - 2 %> more item(s)</small>
                  <% } %>
                </div>
                <div class="col-md-4 text-end">
                  <h5 class="mb-3">Total: ₹<%= order.totalAmount %></h5>
                  <a href="/my-orders/<%= order._id %>" class="btn btn-primary">
                    <i class="fas fa-eye"></i> View Details
                  </a>
                </div>
              </div>

              <!-- Status Timeline -->
              <div class="mt-3 pt-3 border-top">
                <h6 class="mb-2">Order Status:</h6>
                <div class="d-flex justify-content-between position-relative">
                  <!-- Progress bar -->
                  <div style="position: absolute; top: 12px; left: 0; right: 0; height: 2px; background: #e0e0e0; z-index: 0;"></div>
                  
                  <!-- New -->
                  <div class="text-center" style="position: relative; z-index: 1;">
                    <div class="<%= ['New', 'Confirmed', 'Shipped', 'Delivered'].includes(order.status) ? 'bg-primary' : 'bg-secondary' %> rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                      <i class="fas fa-clock text-white"></i>
                    </div>
                    <small class="d-block mt-1">New</small>
                  </div>

                  <!-- Confirmed -->
                  <div class="text-center" style="position: relative; z-index: 1;">
                    <div class="<%= ['Confirmed', 'Shipped', 'Delivered'].includes(order.status) ? 'bg-warning' : 'bg-secondary' %> rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                      <i class="fas fa-check text-white"></i>
                    </div>
                    <small class="d-block mt-1">Confirmed</small>
                  </div>

                  <!-- Shipped -->
                  <div class="text-center" style="position: relative; z-index: 1;">
                    <div class="<%= ['Shipped', 'Delivered'].includes(order.status) ? 'bg-primary' : 'bg-secondary' %> rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                      <i class="fas fa-shipping-fast text-white"></i>
                    </div>
                    <small class="d-block mt-1">Shipped</small>
                  </div>

                  <!-- Delivered -->
                  <div class="text-center" style="position: relative; z-index: 1;">
                    <div class="<%= order.status === 'Delivered' ? 'bg-success' : 'bg-secondary' %> rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                      <i class="fas fa-check-circle text-white"></i>
                    </div>
                    <small class="d-block mt-1">Delivered</small>
                  </div>
                </div>

                <% if (order.status === 'Cancelled') { %>
                  <div class="alert alert-danger mt-3 mb-0">
                    <i class="fas fa-times-circle"></i> This order has been cancelled
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
